{
  "name": "designmd-live",
  "version": "0.0.0",
  "description": "Live editor for DESIGN.md, wired on your real codebase",
  "type": "module",
  "bin": {
    "designmd-live": "./dist/index.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:tsup": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/index.js"
  },
  "dependencies": {
    "@designmd-live/core": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "citty": "^0.1.6",
    "consola": "^3.3.0",
    "hono": "^4.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@designmd-live/panel": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
